# SOC Intelligence Orchestrator
# Arquivo de exemplo - sem credenciais reais.

APP_ENV=development
APP_NAME=soc-intelligence-orchestrator

COLLECTOR_INTERVAL_MINUTES=5
ENABLE_REAL_INTEGRATIONS=false
ENABLE_AI_ANALYSIS=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=soc_intelligence
DB_USER=soc_lab

LLM_PROVIDER=ollama

# MISP - Threat Intelligence read-only
# Nunca colocar chave real neste arquivo de exemplo.
MISP_URL=https://misp.example.local
MISP_API_KEY=CHANGE_ME
MISP_TIMEOUT_SECONDS=10
MISP_VERIFY_TLS=true
